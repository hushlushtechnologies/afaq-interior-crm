{
  "name": "afaq-interior-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src tests playwright.config.ts playwright.design.config.ts playwright.shell.config.ts playwright.prototype.config.ts eslint.config.mjs next.config.ts package.json .prettierrc.json",
    "format:check": "prettier --check src tests playwright.config.ts playwright.design.config.ts playwright.shell.config.ts playwright.prototype.config.ts eslint.config.mjs next.config.ts package.json .prettierrc.json",
    "test": "playwright test",
    "test:design": "playwright test --config playwright.design.config.ts",
    "test:shell": "playwright test --config playwright.shell.config.ts",
    "test:prototype": "playwright test --config playwright.prototype.config.ts",
    "test:all": "npm run test && npm run test:design && npm run test:shell && npm run test:prototype"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fontsource-variable/manrope": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-tooltip": "1.2.8",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-table": "8.21.3",
    "clsx": "2.1.1",
    "lucide-react": "1.65.0",
    "motion": "14.8.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
