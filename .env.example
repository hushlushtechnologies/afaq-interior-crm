# Local development only. Never use loopback URLs in Vercel.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:57421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000

# Local test bindings. Do not add these to Vercel.
E2E_AUTH_EMAIL=developer@example.test
E2E_AUTH_PASSWORD=

# Node-side local test fixtures only.
# Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_LOCAL_TEST_SECRET_KEY=

# Explicitly enable only for isolated local Supabase + local email viewer.
ENABLE_LOCAL_EMPLOYEE_INVITES=false

# Local-only DEC-025 attachment workflow; keep disabled for production.
ENABLE_LOCAL_LEAD_ATTACHMENTS=false

# Local-only capture. Production receiving and worker hosting remain unapproved.
ENABLE_LOCAL_LEAD_CAPTURE=false

# Set only when using an approved local private capture fixture file.
# LOCAL_CAPTURE_CONFIG_FILE must be an absolute path outside Git.